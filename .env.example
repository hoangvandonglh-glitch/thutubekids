# ========================================================
# Google Tools & Integrations Configuration for Thutubekids.com
# ========================================================

# 1. Google Search Console (Mã xác minh thẻ HTML)
# Lấy từ: Search Console > Cài đặt > Xác minh quyền sở hữu > Thẻ HTML
NEXT_PUBLIC_GSC_VERIFICATION=your_gsc_verification_code_here

# 2. Google Analytics 4 (Mã đo lường GA4)
# Lấy từ: Google Analytics > Quản trị > Luồng dữ liệu > Mã đo lường (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 3. Google AdSense (Mã nhà xuất bản & Mã đơn vị quảng cáo)
# Lấy từ: Google AdSense > Tài khoản > Cài đặt tài khoản (ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# (Tùy chọn) Mã các đơn vị quảng cáo AdSense riêng biệt (Lấy từ: AdSense > Quảng cáo > Theo đơn vị quảng cáo)
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_UNDER_PLAYER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_INARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=

# 4. (Tùy chọn) YouTube Data API v3 Key & Vercel Cron Secret
YOUTUBE_API_KEY=
CRON_SECRET=

